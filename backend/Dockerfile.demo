# Build-only candidate for a synthetic demo; not approved for public deployment.
FROM python:3.12-slim AS dependencies
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN groupadd --system rpm && useradd --system --gid rpm --no-create-home rpm
COPY --from=dependencies /app/.venv /app/.venv
COPY --chown=rpm:rpm app ./app
COPY --chown=rpm:rpm rules ./rules
COPY --chown=rpm:rpm migrations ./migrations
COPY --chown=rpm:rpm alembic.ini ./alembic.ini
USER rpm
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
